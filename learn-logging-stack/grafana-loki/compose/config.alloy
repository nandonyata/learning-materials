logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "zerolog" {
  path_targets = [{
    __path__ = "/var/log/zerolog/app.log",
    job      = "zerolog",
    service  = "go-app",
  }]
}

loki.source.file "zerolog" {
  targets    = local.file_match.zerolog.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    // Compose gives Loki the DNS name "loki" on its private network.
    url = "http://loki:3100/loki/api/v1/push"
  }
}
